rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedMember() {
      return request.auth != null && (request.auth.token.email_verified == true || request.auth.token.phone_number != null);
    }

    function acceptedRelationship(relationshipId) {
      let path = /databases/$(database)/documents/relationships/$(relationshipId);
      return verifiedMember()
        && exists(path)
        && get(path).data.status == 'accepted'
        && request.auth.uid in get(path).data.members;
    }

    function callMember(callId) {
      let path = /databases/$(database)/documents/calls/$(callId);
      return verifiedMember()
        && exists(path)
        && request.auth.uid in get(path).data.members;
    }

    match /handles/{handle} {
      allow get: if verifiedMember();
      allow list: if false;
      allow create: if verifiedMember()
        && handle.matches('^SFN-[A-Z0-9]{4}-([A-Z0-9]{4}|[A-F0-9]{5,512}[A-F0-9]{0,512})$')
        && request.resource.data.keys().hasOnly(['uid', 'handle', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle == handle
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow get: if verifiedMember();
      allow list: if false;
      allow create: if verifiedMember()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'handle', 'displayName', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.handle.matches('^SFN-[A-Z0-9]{4}-([A-Z0-9]{4}|[A-F0-9]{5,512}[A-F0-9]{0,512})$')
        && request.resource.data.displayName == request.resource.data.handle
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid;
      allow update: if verifiedMember()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handle', 'displayName'])
        && request.resource.data.handle.matches('^SFN-[A-Z0-9]{4}-([A-Z0-9]{4}|[A-F0-9]{5,512}[A-F0-9]{0,512})$')
        && request.resource.data.displayName == request.resource.data.handle
        && request.resource.data.displayName.size() <= 1033
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid;
      allow delete: if false;
    }

    match /relationships/{relationshipId} {
      allow get, list: if verifiedMember() && request.auth.uid in resource.data.members;
      allow create: if verifiedMember()
        && request.resource.data.keys().hasOnly(['members', 'requesterUid', 'recipientUid', 'status', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] is string
        && request.resource.data.members[1] is string
        && request.resource.data.members[0] < request.resource.data.members[1]
        && relationshipId == request.resource.data.members[0] + '__' + request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.recipientUid in request.resource.data.members
        && request.resource.data.recipientUid != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUid))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if verifiedMember() && (
        (request.auth.uid == resource.data.recipientUid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted', 'declined'])
        || (resource.data.status == 'declined'
          && request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'requesterUid', 'recipientUid'])
          && request.resource.data.status == 'pending'
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.recipientUid in resource.data.members
          && request.resource.data.recipientUid != request.auth.uid
          && request.resource.data.members == resource.data.members));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if acceptedRelationship(relationshipId);
        allow create: if acceptedRelationship(relationshipId)
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 3000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /calls/{callId} {
      allow get, list: if verifiedMember() && request.auth.uid in resource.data.members;
      allow create: if verifiedMember()
        && request.resource.data.keys().hasOnly(['relationshipId', 'members', 'callerUid', 'calleeUid', 'status', 'offer', 'createdAt'])
        && request.resource.data.relationshipId is string
        && acceptedRelationship(request.resource.data.relationshipId)
        && request.resource.data.members == get(/databases/$(database)/documents/relationships/$(request.resource.data.relationshipId)).data.members
        && request.resource.data.members.size() == 2
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid in request.resource.data.members
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.offer is map
        && request.resource.data.offer.keys().hasOnly(['type', 'sdp'])
        && request.resource.data.offer.type == 'offer'
        && request.resource.data.offer.sdp is string
        && request.resource.data.offer.sdp.size() <= 50000
        && request.resource.data.createdAt == request.time;
      allow update: if verifiedMember()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status'])
        && (
          (request.auth.uid == resource.data.calleeUid
            && resource.data.status == 'ringing'
            && request.resource.data.status == 'active'
            && request.resource.data.answer is map
            && request.resource.data.answer.keys().hasOnly(['type', 'sdp'])
            && request.resource.data.answer.type == 'answer'
            && request.resource.data.answer.sdp is string
            && request.resource.data.answer.sdp.size() <= 50000)
          || (request.auth.uid == resource.data.calleeUid
            && resource.data.status == 'ringing'
            && request.resource.data.status == 'declined')
          || (request.auth.uid in resource.data.members
            && request.resource.data.status == 'ended')
        );
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if callMember(callId);
        allow create: if callMember(callId)
          && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid
          && request.resource.data.keys().hasOnly(['candidate', 'createdAt'])
          && request.resource.data.candidate is map
          && request.resource.data.candidate.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment'])
          && request.resource.data.candidate.candidate is string
          && request.resource.data.candidate.candidate.size() <= 2048
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if callMember(callId);
        allow create: if callMember(callId)
          && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid
          && request.resource.data.keys().hasOnly(['candidate', 'createdAt'])
          && request.resource.data.candidate is map
          && request.resource.data.candidate.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment'])
          && request.resource.data.candidate.candidate is string
          && request.resource.data.candidate.candidate.size() <= 2048
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
